"""Layered runtime configuration.

One resolution chain for every parameter, first hit wins:

1. Databricks widget / job ``base_parameters`` — when a ``dbutils`` is passed
2. Environment variable — DAB ``variables:`` surface here on job tasks
3. The default the caller provides

so the same code runs unchanged in a Job task, an ad-hoc notebook, and a
local test. Catalog names are rendered from ``conventions.naming`` in
``tramat.yml``; change them there, not here.
"""

from __future__ import annotations

import os
from typing import Any

#: catalog = environment (schema-per-source naming; see tramat.yml)
CATALOGS: dict[str, str] = {
    "dev": "{{tramat.dev_catalog}}",
    "staging": "{{tramat.staging_catalog}}",
    "prod": "{{tramat.prod_catalog}}",
}
DEFAULT_ENV = "dev"

#: mirrors conventions.naming.landing_volume in tramat.yml
LANDING_VOLUME_PATTERN = "/Volumes/{catalog}/{source}/landing"


def is_databricks() -> bool:
    """True when running on a Databricks runtime (job task or notebook)."""
    return "DATABRICKS_RUNTIME_VERSION" in os.environ


def _widget(name: str, dbutils: Any) -> str | None:
    if dbutils is None:
        return None
    try:
        value = dbutils.widgets.get(name)
    except Exception:
        return None
    value = (value or "").strip()
    return value or None


def get_param(name: str, default: str | None = None, *, required: bool = False, dbutils: Any = None) -> str | None:
    """Resolve a parameter through the widget → environment → default chain."""
    value = _widget(name, dbutils)
    if value is None:
        value = os.environ.get(name) or None
    if value is None:
        value = default
    if required and value is None:
        raise RuntimeError(f"required parameter {name!r} not set (widget, env var, or default)")
    return value


def get_deployment_env(dbutils: Any = None) -> str:
    """Current deployment environment name (``DEPLOYMENT_ENV``), validated."""
    env = get_param("DEPLOYMENT_ENV", DEFAULT_ENV, dbutils=dbutils)
    if env not in CATALOGS:
        raise RuntimeError(f"unknown DEPLOYMENT_ENV {env!r}; expected one of {sorted(CATALOGS)}")
    return env


def get_catalog(env: str | None = None, dbutils: Any = None) -> str:
    """Unity Catalog for an environment; ``CATALOG`` param overrides the map."""
    override = get_param("CATALOG", dbutils=dbutils)
    if override and env is None:
        return override
    return CATALOGS[env or get_deployment_env(dbutils=dbutils)]


def get_landing_dir(source: str, env: str | None = None, dbutils: Any = None) -> str:
    """UC Volume landing path for a source, e.g. ``/Volumes/{{tramat.dev_catalog}}/players/landing``."""
    catalog = get_catalog(env=env, dbutils=dbutils)
    return LANDING_VOLUME_PATTERN.format(catalog=catalog, source=source)


def setup_widgets(dbutils: Any, definitions: dict[str, dict[str, Any]]) -> dict[str, str]:
    """Declare notebook widgets and export their values as environment variables.

    ``definitions`` maps parameter name → ``{"default": str, "label": str,
    "choices": [..]}`` (``choices`` makes it a dropdown). Existing environment
    variables win over widget values, keeping the resolution chain consistent.
    Returns the resolved values.
    """
    resolved: dict[str, str] = {}
    for name, config in definitions.items():
        default = str(config.get("default", ""))
        label = str(config.get("label", name))
        choices = config.get("choices")
        if choices:
            dbutils.widgets.dropdown(name, default, [str(c) for c in choices], label)
        else:
            dbutils.widgets.text(name, default, label)
    for name in definitions:
        value = os.environ.get(name)
        if value is None:
            value = str(dbutils.widgets.get(name))
        resolved[name] = value
        os.environ[name] = value
    return resolved
