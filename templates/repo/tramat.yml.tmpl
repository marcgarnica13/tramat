# tramat manifest — the source of truth for this repo's conventions and data graph.
# merged tier: doctor validates it against the schema; the content is yours.
# Docs: https://github.com/marcgarnica13/tramat
tramat: 1

project:
  name: {{tramat.project_name}}
  mode: standard

conventions:
  naming:
    scheme: schema-per-source
    catalog_per_env:
      dev: {{tramat.dev_catalog}}
      staging: {{tramat.staging_catalog}}
      prod: {{tramat.prod_catalog}}
    layer_style: suffix          # players_bronze / players_silver / players_gold
    gold_semantic: true          # dim_* / fct_* allowed in gold
    landing_volume: "/Volumes/{catalog}/{source}/landing"
  layout:
    resources_dir: resources
    src_package: src/{{tramat.package}}
    pipelines_dir: pipelines
  compute:
    default: serverless          # every job task and SDP pipeline unless assigned below
    serverless:
      environment_version: "4"
    classic_profiles: {}         # named job-cluster shapes; every entry needs a reason
    assignments: {}              # e.g. { my_scraper_job: my-classic-profile }
  targets:
    dev:
      catalog: {{tramat.dev_catalog}}
      schedules: false
      run_as_sp: {{tramat.run_as_sp}}
    staging:
      catalog: {{tramat.staging_catalog}}
      schedules: false
      run_as_sp: {{tramat.run_as_sp}}
    prod:
      catalog: {{tramat.prod_catalog}}
      schedules: true            # schedules live only in prod
      run_as_sp: {{tramat.run_as_sp}}
  qa:
    coverage_min: 0.30
    row_count_tolerance: 0.05
    verify_default_tier: static  # Tier 1 (dev deploy + sample run) only on explicit request
  openwiki:
    enabled: false
  brain:
    mode: "off"                  # off | skill | mcp — personal work-journal integration

review:
  second_opinion:
    enabled: false               # cross-AI review gate; needs the codex CLI

graph:
  defaults:
    catalog: {{tramat.prod_catalog}}
    dev_catalog: {{tramat.dev_catalog}}
  steps: []                      # scaffold commands add steps here; edges carry via:, retries need signed idempotency
