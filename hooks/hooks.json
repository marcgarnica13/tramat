{
  "description": "tramat hooks: orient every session with manifest status (<1s, no network).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_status.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_status.py\" || true"
          }
        ]
      }
    ]
  }
}
